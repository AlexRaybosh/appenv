{
	"include" : ["db", "allincludes","task"],
	
	"appConf" : {
		"testapp1" : {
		},
		"testapp2" : {		
		}
	},

	"bootstrap" : {
		"shell" : "/bin/bash",
		"abortOnError" : false,
		"abortOnErrorIfShellEval" : "[[ \"$APP_ENV_TYPE\" == \"prod\" || \"$APP_ENV_TYPE\" == \"beta\" ]] || { echo non production environment $APP_ENV_TYPE detected>&2; exit 1; }",
		"overrideConfNameFromEnvironmentVariable" : "APP_CONF_NAME",
		"overrideEnvTypeFromEnvironmentVariable" : "APP_ENV_TYPE",
		"logErrors" : true,
		"disableDatabaseEnvironmentVariable" : "DISABLE_DB",
		"entries" : [
			{
				"propertiesEntryType" : "SHELL_EVAL",
				"shellArgument" : "${PROPERTIES_PROVIDER}"		
			},
			{
				"propertiesEntryType" : "SHELL_EVAL",
				"shellArgument" : "${HOME}/${APP_ENV_TYPE}/test_props_provider.sh",
				"abortOnExecutionError" : true			
			},		
			{
				"propertiesEntryType" : "FILE_EXEC",
				"file" : "./src/main/java/test_props_provider.sh",
				"args" : ["skip", "me"],
				"abortOnFileMissing" : false,
				"abortOnFileNotExecutable" : false,
				"abortOnExecutionError" : true
			},						
			{
				"propertiesEntryType" : "FILE",
				"file" : "./src/main/java/test_props_provider.properties",
				"abortOnLoadError" : true,
				"abortOnFileMissing" : false
			},			
			{
				"propertiesEntryType" : "BUILDIN",
				"properties" : {
					"dburl"	:	"jdbc:postgresql://localhost:5432/postgres?sslmode=disable",
					"dbuser":	"postgres",
					"dbpassword" : "pg",
					"debug" : "true",
					"appConf" : "test-app",
					"logdbpassword" : "test2",
					"envType" : "localdev"
				}
			}
		]
	},
	
		"defaults" : {
		"subsystems" : {
			"initConcurrency" : 1,
			"entries" : {
			}
		},
		"database" : {
			"dumbdownPostgresNoSeqScan" : {
				"because" : "Postgres sucks",
				"properties" : {
					"dburl"	:	"jdbc:postgresql://localhost:5432/postgres?sslmode=disable",
					"dbuser":	"postgres",
					"dbpasswordBootstrapPropertyName" : "dbpassword"
				}
			}		
		}
	}
}